# ---- Local model (Ollama: https://ollama.com) ----
OLLAMA_URL=http://127.0.0.1:11434
# Light default (about 2.2 GB, MIT licence). For better quality with 8 GB+ RAM try qwen2.5:7b (Apache-2.0).
OLLAMA_MODEL=phi3.5
# Context window in tokens. Larger = longer PRDs but more RAM and slower.
NUM_CTX=8192
# Requests sent to the model at once. Keep at 1 on laptops (also gives the best prompt caching).
MAX_PARALLEL=1

# ---- Jira Cloud (optional; only needed for "Create in Jira") ----
# Obtain the API token through your approved secrets process (GICS). Never commit this file.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

PORT=8787
